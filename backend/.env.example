PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/advising
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Your deployed frontend's origin - restricts CORS to just this site. Defaults
# to the Next.js dev server (http://localhost:3000) if left unset, so local
# development works without changing this, but set it explicitly in production.
FRONTEND_URL=http://localhost:3000
